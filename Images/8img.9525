			<div class="article-title">Fast Food Recipes</div>
			</div>
			<div class="article-features">
				<div class="article-date">
					<div class="article-logo"><img src="https://www.restaurantindia.in/themes/menshealth/images/artlogo.jpg" alt="" class="img-fluid" height="51" width="51"></div>
					<div class="article-time">Published by - <a href="/author/jaspal-singh">Jaspal Singh</a><br/>
										<span>Jun 24, 2017 / <img src="https://www.restaurantindia.in/themes/menshealth/images/vicon.webp" height="10" width="17" alt="IndianRetailer" class="img-fluid"> <div class="views-element-container"><div class="js-view-dom-id-6e050014d578785428a704f2fb6c6ef0178690cbf66c4833df56fbd892f06b84">
  
  
  

  
  
  

